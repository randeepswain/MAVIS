# =====================================================================
# MAVIS - Multi-Agent Voice Intake System Environment Configuration
# Copy this file to '.env' and adjust values as needed.
# Defaults work out-of-the-box for local execution!
# =====================================================================

# Project Metadata
PROJECT_NAME="MAVIS — Multi-Agent Voice Intake System"
VERSION="1.0.0"
API_PREFIX="/api"

# Database Configuration
# Default: SQLite (zero-setup local execution with Write-Ahead Logging)
DATABASE_URL="sqlite+aiosqlite:///./mavis.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/mavis"

# Redis & Concurrency Engine
# Default: Uses built-in in-memory fallback if Redis is not running
REDIS_URL="redis://localhost:6379/0"
SLOT_HOLD_TTL_SECONDS=180

# Security & Authentication
JWT_SECRET="mavis-ultra-secure-jwt-secret-key-2026-ramaiah"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM / Groq (Optional - deterministic rule-based NLP fallback is active if omitted)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama3-70b-8192"

# Emergency Response Desk
EMERGENCY_DESK_PHONE="+91-80-2360-1234"

# Telephony & Audio (LiveKit WebRTC Gateway)
LIVEKIT_URL="wss://livekit.mavis.local"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
